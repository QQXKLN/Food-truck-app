# Local PostgreSQL connection.
DATABASE_URL=postgres://usuario:password@localhost:5432/food_truck_db

# Railway injects PORT automatically in production.
PORT=3000

# Use production in Railway.
NODE_ENV=development

# JWT signing secret. Replace in production with a long random value.
JWT_SECRET=tu_clave_segura

# Frontend URL allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Operational timezone for active locations and daily menu dates.
APP_TIMEZONE=America/Santiago
